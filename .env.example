# OpenDRM Configuration

# Database
DATABASE_URL=postgresql://opendrm:opendrm@localhost:5432/opendrm
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# License Server
LICENSE_SERVER_PORT=3000
LICENSE_SERVER_HOST=0.0.0.0
LICENSE_SERVER_GRPC_PORT=50051

# Key Encryption
# Generate with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=your-32-byte-hex-secret-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=1h

# Enterprise DRM (optional)
WIDEVINE_LICENSE_SERVER_URL=
WIDEVINE_SIGNING_KEY=
WIDEVINE_SIGNING_IV=

FAIRPLAY_LICENSE_SERVER_URL=
FAIRPLAY_ASK=
FAIRPLAY_CERTIFICATE_PATH=

# Packager Service
PACKAGER_PORT=3001
PACKAGER_GRPC_PORT=50052
SHAKA_PACKAGER_PATH=/usr/bin/packager

# Storage Configuration
STORAGE_BACKEND=local
# local, s3, gcs, azure

# Local Storage
LOCAL_STORAGE_PATH=/data/content

# S3 Storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# GCS Storage
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_KEY_FILE=

# Azure Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=info
