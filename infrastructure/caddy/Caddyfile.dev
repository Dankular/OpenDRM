# OpenDRM Caddy Development Configuration
# No HTTPS, more permissive for local development

{
    # Disable automatic HTTPS for development
    auto_https off

    # Admin API for debugging
    admin :2019

    # Debug logging
    log {
        output stdout
        format console
        level DEBUG
    }
}

:80 {
    # License Server API
    handle /api/v1/license/* {
        reverse_proxy license-server:3000
    }

    # Admin API
    handle /api/v1/* {
        reverse_proxy license-server:3000
    }

    # Metrics
    handle /metrics {
        reverse_proxy license-server:3000
    }

    # Health
    handle /health {
        reverse_proxy license-server:3000
    }

    # Content delivery through Varnish
    handle /content/* {
        reverse_proxy varnish:80
    }

    # Packager service
    handle /packager/* {
        uri strip_prefix /packager
        reverse_proxy packager-service:3001
    }

    # CORS for development
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods *
        Access-Control-Allow-Headers *
    }

    # Handle OPTIONS preflight
    @options method OPTIONS
    respond @options 204

    # Compression
    encode gzip

    log {
        output stdout
        format console
    }
}
