{
  "name": "opendrm",
  "version": "0.1.0",
  "private": true,
  "description": "Open Source DRM Solution with ClearKey and Enterprise License Server Support",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/opendrm"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @opendrm/license-server run db:migrate",
    "db:seed": "pnpm --filter @opendrm/license-server run db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "prettier": "^3.2.0",
    "eslint": "^9.0.0"
  }
}
