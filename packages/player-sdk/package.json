{
  "name": "@opendrm/player-sdk",
  "version": "0.1.0",
  "description": "OpenDRM Player SDK - Shaka Player and Video.js integration with DRM support",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./shaka": {
      "import": "./dist/shaka-adapter.esm.js",
      "require": "./dist/shaka-adapter.js",
      "types": "./dist/shaka-adapter.d.ts"
    },
    "./videojs": {
      "import": "./dist/videojs-adapter.esm.js",
      "require": "./dist/videojs-adapter.js",
      "types": "./dist/videojs-adapter.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "shaka-player": "^4.0.0",
    "video.js": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "shaka-player": {
      "optional": true
    },
    "video.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/video.js": "^7.3.0",
    "shaka-player": "^4.7.0",
    "typescript": "^5.3.0",
    "video.js": "^8.10.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.2.0"
  }
}
